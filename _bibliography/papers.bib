@article{DALAL2026111341,
title = {Computer vision based automated quantification of agricultural sprayers boom displacement},
journal = {Computers and Electronics in Agriculture},
volume = {243},
pages = {111341},
year = {2026},
issn = {0168-1699},
doi = {https://doi.org/10.1016/j.compag.2025.111341},
url = {https://www.sciencedirect.com/science/article/pii/S0168169925014474},
author = {Aryan Singh Dalal and Sidharth Rai and Rahul Singh and Treman Singh Kaloya and Rahul Harsha Cheppally and Ajay Sharda},
keywords = {Self-propelled sprayer, Boom movement, Spray coverage quantification, Computer vision, YOLO},
abstract = {Uncontrolled movement of wide agricultural spray booms (up to 38 m) operating at high speeds (up to 30 kph) is a major contributor to spray application errors. However, systematically developing solutions is hindered by a critical measurement gap: existing sensor methods, such as accelerometers and ultrasonic sensors, are limited by signal drift, restricted range, or an inability to simultaneously quantify both vertical and transverse displacements in real-time field conditions. To address this gap, we developed a novel, automated computer vision system designed to robustly quantify multi-axial boom displacement. The system integrates a monocular camera with a YOLO neural network (optimized to YOLOv8) to track a custom-designed 3D target at the boom’s extremity, a method specifically developed after fiducial markers (ArUco) proved unreliable in field conditions. The system’s performance was validated against a ground-truth inclinometer during field trials in corn and wheat. Our model detected the target with high and stable accuracy (mAP@.50 = 0.995, 95 % CI: 0.993–0.997), and its displacement estimates were validated to within a Mean Absolute Error of 0.026 m of the inclinometer data, even for complex boom movements up to 3 m in both axes. This work provides the first practical, vision-based tool for capturing critical quantitative data on complex boom dynamics, creating an essential foundation for engineers to design, test, and implement new active control systems to enhance spray application accuracy.}
}

@article{CHEPPALLY2023100182,
title = {Seed localization system suite with CNNs for seed spacing estimation, population estimation and doubles identification},
journal = {Smart Agricultural Technology},
volume = {4},
pages = {100182},
year = {2023},
issn = {2772-3755},
doi = {https://doi.org/10.1016/j.atech.2023.100182},
url = {https://www.sciencedirect.com/science/article/pii/S2772375523000126},
author = {Rahul Harsha Cheppally and Ajay Sharda and Guanghui Wang},
keywords = {Planting systems, Seed population estimation, Seed localization, Deep learning, Convolutional neural networks, Artificial intelligence},
abstract = {Seed placement information for evaluating planters is obtained by tedious manual methods like using a pogostick or a ruler. To obtain more information and reduce the time required. There is a need for an automated system. The goal of this study is to design such a system with the use of GPS and seed detection. A 12-row planter was instrumented with cameras and a GPS. The planter was operated at planting speeds of 9.66 kmph and 12.87 kmph with a seed population of 74,131 and 86,4868 seeds per hectare respectively and seed spacing was measured manually using a ruler. YOLOR-P6, YOLOR-CSPX, YOLOX-S, YOLOX-M, YOLOX-L, YOLOX-TINY, and YOLOV4 were trained to detect seeds on a different dataset. An algorithm was designed to estimate the distance between two consecutive seeds by filtering out old detections from the detector with the use of the IOU metric and GPS stream. The seed spacing estimator was evaluated on Jensen–Shannon Divergence (JSD), mean, standard deviation, ΔCount, and RMS metrics. Results indicate that the developed system along with the algorithm was able to perform better at 9.66 kmph with JSD distances of 0.223 and 0.244 (74,131 and 86,4868 seeds per hectare respectively) compared to 0.298 and 0.258 (74,131 and 86,4868 seeds per hectare respectively) at 12.87 kmph. Moreover, this algorithm was able to reduce the total time taken to detect seed and estimate seed spacing information from 2hrs by manual method to 1 min 14 seconds using YOLOR-CSPX.}
}